# Copy this file to `.env` (gitignored) and fill in the token. The notebooks read
# `.env` at the repo root first; in Colab, use the Secrets panel (key icon) instead
# and name the secret exactly HF_TOKEN.
#
# The warehouse is gated. Accept the gate before creating the token, or it returns
# 401 with no explanation:
#   https://huggingface.co/datasets/FlyRank/internship-warehouse
# READ token: https://huggingface.co/settings/tokens
HF_TOKEN=hf_replace_with_your_read_token
